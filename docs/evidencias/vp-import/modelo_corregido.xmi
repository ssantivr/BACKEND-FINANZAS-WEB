      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_TokenRecuperacion" name="TokenRecuperacion">
        <ownedComment xmi:type="uml:Comment" xmi:id="C_TokenRecuperacion_st" body="stereotype: entity" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_TokenRecuperacion_id" name="id" visibility="private" type="T_UUID" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_TokenRecuperacion_hash" name="hash" visibility="private" type="T_String" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_TokenRecuperacion_idUsuario" name="idUsuario" visibility="private" type="T_UUID" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_TokenRecuperacion_expira" name="expira" visibility="private" type="T_LocalDateTime" isReadOnly="true" />
