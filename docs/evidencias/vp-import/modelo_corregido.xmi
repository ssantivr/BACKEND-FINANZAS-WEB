        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Gasto_getMetodoPago" name="getMetodoPago" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Gasto_getMetodoPago__return" name="return" direction="return" type="E_MetodoPago" />
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_Ingreso" name="Ingreso">
        <ownedComment xmi:type="uml:Comment" xmi:id="C_Ingreso_st" body="stereotype: entity" />
        <generalization xmi:type="uml:Generalization" xmi:id="G_Ingreso_Movimiento" general="C_Movimiento" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Ingreso_fuente" name="fuente" visibility="private" type="T_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="P_Ingreso_fuente_lo" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="P_Ingreso_fuente_up" value="1" />
        </ownedAttribute>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Ingreso_getTipo" name="getTipo" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Ingreso_getTipo__return" name="return" direction="return" type="E_TipoMovimiento" />
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Ingreso_getFuente" name="getFuente" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Ingreso_getFuente__return" name="return" direction="return" type="T_String" />
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_Categoria" name="Categoria">
        <ownedComment xmi:type="uml:Comment" xmi:id="C_Categoria_st" body="stereotype: entity" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Categoria_id" name="id" visibility="private" type="T_UUID" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Categoria_nombre" name="nombre" visibility="private" type="T_String" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Categoria_tipo" name="tipo" visibility="private" type="E_TipoMovimiento" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Categoria_icono" name="icono" visibility="private" type="T_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="P_Categoria_icono_lo" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="P_Categoria_icono_up" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Categoria_idPropietario" name="idPropietario" visibility="private" type="T_UUID">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="P_Categoria_idPropietario_lo" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="P_Categoria_idPropietario_up" value="1" />
        </ownedAttribute>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Categoria_esPredeterminada" name="esPredeterminada" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Categoria_esPredeterminada__return" name="return" direction="return" type="T_boolean" />
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Categoria_estaDisponiblePara" name="estaDisponiblePara" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Categoria_estaDisponiblePara__idUsuario" name="idUsuario" direction="in" type="T_UUID" />
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Categoria_estaDisponiblePara__return" name="return" direction="return" type="T_boolean" />
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Categoria_renombrar" name="renombrar" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Categoria_renombrar__nombre" name="nombre" direction="in" type="T_String" />
        </ownedOperation>
        <ownedRule xmi:type="uml:Constraint" xmi:id="K_Categoria_RN_09_nombre" name="RN_09_nombre">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="K_Categoria_RN_09_nombre_s">
            <language>OCL</language>
            <body>self.nombre.size() &gt;= 1 and self.nombre.size() &lt;= 40 and Categoria.allInstances()-&gt;select(c | c.idPropietario = self.idPropietario and c.tipo = self.tipo)-&gt;isUnique(c | c.nombre)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="K_Categoria_RN_14_PROPUESTA_sin_duplicar_predeterminada" name="RN_14_PROPUESTA_sin_duplicar_predeterminada">
          <ownedComment xmi:type="uml:Comment" xmi:id="K_Categoria_RN_14_PROPUESTA_sin_duplicar_predeterminada_c" body="PROPUESTA: una categoria propia no puede tener el mismo nombre normalizado y tipo que una predeterminada. No es requisito original." />
          <specification xmi:type="uml:OpaqueExpression" xmi:id="K_Categoria_RN_14_PROPUESTA_sin_duplicar_predeterminada_s">
            <language>OCL</language>
            <body>self.idPropietario-&gt;notEmpty() implies Categoria.allInstances()-&gt;select(d | d.idPropietario-&gt;isEmpty())-&gt;forAll(d | d.tipo &lt;&gt; self.tipo or d.nombre.toLowerCase().trim() &lt;&gt; self.nombre.toLowerCase().trim())</body>
          </specification>
        </ownedRule>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_Presupuesto" name="Presupuesto">
        <ownedComment xmi:type="uml:Comment" xmi:id="C_Presupuesto_st" body="stereotype: entity" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Presupuesto_id" name="id" visibility="private" type="T_UUID" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Presupuesto_idUsuario" name="idUsuario" visibility="private" type="T_UUID" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Presupuesto_categoria" name="categoria" visibility="private" type="C_Categoria" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Presupuesto_periodo" name="periodo" visibility="private" type="T_YearMonth" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Presupuesto_limite" name="limite" visibility="private" type="C_Dinero" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Presupuesto_notificado" name="notificado" visibility="private" type="T_boolean" />
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Presupuesto_calcularEstado" name="calcularEstado" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Presupuesto_calcularEstado__consumo" name="consumo" direction="in" type="C_Dinero" />
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Presupuesto_calcularEstado__return" name="return" direction="return" type="E_EstadoPresupuesto" />
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Presupuesto_debeNotificar" name="debeNotificar" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Presupuesto_debeNotificar__consumo" name="consumo" direction="in" type="C_Dinero" />
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Presupuesto_debeNotificar__return" name="return" direction="return" type="T_boolean" />
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Presupuesto_marcarNotificado" name="marcarNotificado" visibility="public" />
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Presupuesto_cambiarLimite" name="cambiarLimite" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Presupuesto_cambiarLimite__limite" name="limite" direction="in" type="C_Dinero" />
        </ownedOperation>
        <ownedRule xmi:type="uml:Constraint" xmi:id="K_Presupuesto_RN_10_solo_gasto_unico" name="RN_10_solo_gasto_unico">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="K_Presupuesto_RN_10_solo_gasto_unico_s">
            <language>OCL</language>
            <body>self.categoria.tipo = TipoMovimiento::GASTO and Presupuesto.allInstances()-&gt;select(p | p.idUsuario = self.idUsuario)-&gt;isUnique(p | Tuple{c = p.categoria, m = p.periodo})</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="K_Presupuesto_RN_12_alerta_una_vez" name="RN_12_alerta_una_vez">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="K_Presupuesto_RN_12_alerta_una_vez_s">
            <language>OCL</language>
            <body>self.debeNotificar(consumo) = (self.calcularEstado(consumo) = EstadoPresupuesto::EXCEDIDO and not self.notificado)</body>
          </specification>
        </ownedRule>
      </packagedElement>
