      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="T_long" name="long" />
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="T_boolean" name="boolean" />
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="T_Currency" name="Currency" />
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PK_dominio" name="dominio">
      <packagedElement xmi:type="uml:Class" xmi:id="C_Usuario" name="Usuario">
        <ownedComment xmi:type="uml:Comment" xmi:id="C_Usuario_st" body="stereotype: entity" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_id" name="id" visibility="private" type="T_UUID" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_nombre" name="nombre" visibility="private" type="T_String" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_correo" name="correo" visibility="private" type="C_Email" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_hashContrasena" name="hashContrasena" visibility="private" type="T_String" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_estado" name="estado" visibility="private" type="E_EstadoCuenta" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_intentosFallidos" name="intentosFallidos" visibility="private" type="T_int" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_bloqueadoHasta" name="bloqueadoHasta" visibility="private" type="T_LocalDateTime">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="P_Usuario_bloqueadoHasta_lo" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="P_Usuario_bloqueadoHasta_up" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_fechaRegistro" name="fechaRegistro" visibility="private" type="T_LocalDateTime" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_eliminadaEn" name="eliminadaEn" visibility="private" type="T_LocalDateTime">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="P_Usuario_eliminadaEn_lo" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="P_Usuario_eliminadaEn_up" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Usuario_bloqueada" name="bloqueada" visibility="public" type="T_boolean" isDerived="true">
          <ownedRule xmi:type="uml:Constraint" xmi:id="K_Usuario_bloqueada_derivacion" name="bloqueada_derivacion">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="K_Usuario_bloqueada_derivacion_s">
              <language>OCL</language>
              <body>derive: bloqueadoHasta &lt;&gt; null and bloqueadoHasta &gt; now()</body>
            </specification>
          </ownedRule>
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="K_Usuario_RN_06_correo_unico_minusculas" name="RN_06_correo_unico_minusculas">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="K_Usuario_RN_06_correo_unico_minusculas_s">
            <language>OCL</language>
            <body>self.correo.valor = self.correo.valor.toLowerCase() and Usuario.allInstances()-&gt;isUnique(u | u.correo.valor)</body>
          </specification>
        </ownedRule>
        <ownedComment xmi:type="uml:Comment" xmi:id="C_Usuario_d1" body="D-1: eliminadaEn + borrado logico (EstadoCuenta.ELIMINADA). D-4: BLOQUEADA se deriva de bloqueadoHasta." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_Movimiento" name="Movimiento" isAbstract="true">
        <ownedComment xmi:type="uml:Comment" xmi:id="C_Movimiento_st" body="stereotype: entity" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Movimiento_id" name="id" visibility="private" type="T_UUID" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Movimiento_idUsuario" name="idUsuario" visibility="private" type="T_UUID" isReadOnly="true" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Movimiento_monto" name="monto" visibility="protected" type="C_Dinero" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Movimiento_fecha" name="fecha" visibility="protected" type="T_LocalDate" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Movimiento_descripcion" name="descripcion" visibility="protected" type="T_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="P_Movimiento_descripcion_lo" value="0" />
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="P_Movimiento_descripcion_up" value="1" />
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Movimiento_categoria" name="categoria" visibility="protected" type="C_Categoria" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Movimiento_fechaRegistro" name="fechaRegistro" visibility="protected" type="T_LocalDateTime" isReadOnly="true" />
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Movimiento_getTipo" name="getTipo" visibility="public" isAbstract="true">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Movimiento_getTipo__return" name="return" direction="return" type="E_TipoMovimiento" />
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Movimiento_getSigno" name="getSigno" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Movimiento_getSigno__return" name="return" direction="return" type="T_int" />
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Movimiento_modificar" name="modificar" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Movimiento_modificar__monto" name="monto" direction="in" type="C_Dinero" />
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Movimiento_modificar__fecha" name="fecha" direction="in" type="T_LocalDate" />
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Movimiento_modificar__descripcion" name="descripcion" direction="in" type="T_String" />
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Movimiento_modificar__categoria" name="categoria" direction="in" type="C_Categoria" />
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Movimiento_perteneceA" name="perteneceA" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Movimiento_perteneceA__idUsuario" name="idUsuario" direction="in" type="T_UUID" />
          <ownedParameter xmi:type="uml:Parameter" xmi:id="OP_Movimiento_perteneceA__return" name="return" direction="return" type="T_boolean" />
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Movimiento_validar" name="validar" visibility="protected" />
        <ownedRule xmi:type="uml:Constraint" xmi:id="K_Movimiento_RN_01_monto" name="RN_01_monto">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="K_Movimiento_RN_01_monto_s">
            <language>OCL</language>
            <body>self.monto.esPositivo() and self.monto.cantidad.scale() &lt;= 2 and self.monto.cantidad &lt;= 999999999999.99</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="K_Movimiento_RN_03_tipo_categoria" name="RN_03_tipo_categoria">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="K_Movimiento_RN_03_tipo_categoria_s">
            <language>OCL</language>
            <body>self.categoria.tipo = self.getTipo()</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="K_Movimiento_RN_04_categoria_disponible" name="RN_04_categoria_disponible">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="K_Movimiento_RN_04_categoria_disponible_s">
            <language>OCL</language>
            <body>self.categoria.idPropietario-&gt;isEmpty() or self.categoria.idPropietario = self.idUsuario</body>
          </specification>
        </ownedRule>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_Gasto" name="Gasto">
        <ownedComment xmi:type="uml:Comment" xmi:id="C_Gasto_st" body="stereotype: entity" />
        <generalization xmi:type="uml:Generalization" xmi:id="G_Gasto_Movimiento" general="C_Movimiento" />
        <ownedAttribute xmi:type="uml:Property" xmi:id="P_Gasto_metodoPago" name="metodoPago" visibility="private" type="E_MetodoPago" />
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Gasto_getTipo" name="getTipo" visibility="public">
