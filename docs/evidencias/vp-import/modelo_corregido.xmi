<?xml version='1.0' encoding='UTF-8'?>
<xmi:XMI xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmi:version="2.1">
  <uml:Model xmi:id="M_root" name="Finanzas_Personales_corregido">
    <ownedComment xmi:type="uml:Comment" xmi:id="CM_header" body="Generado en rama ai/redesign 2026-11-09. Importación en Visual Paradigm: NO VERIFICADO." />
